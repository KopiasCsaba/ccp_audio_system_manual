[Unit]
Description=MediaMTX RTSP/RTMP/HLS/WebRTC media server
After=network-online.target
Wants=network-online.target
# Never stop retrying: a failed wait must not permanently kill the service.
StartLimitIntervalSec=0
# network-online.target alone is not enough here: NetworkManager-wait-online is
# masked on this image, so the target is reached instantly. mediamtx collects the
# WebRTC ICE host candidates from the interfaces at startup, so if it starts
# before eth0 has a DHCP lease it advertises useless candidates (or only usb0's),
# the player page loads but the video never arrives. ExecStartPre below is what
# actually gates the start.

[Service]
Type=simple
User=ccpadmin
Group=ccpadmin
# Wait (max 60s) for eth0 to actually own a routable IPv4 address.
ExecStartPre=/bin/sh -c 'i=0; while [ $i -lt 60 ]; do ip -4 -o addr show dev eth0 scope global | grep -q "inet " && exit 0; i=$((i+1)); sleep 1; done; echo "eth0 has no IPv4 address after 60s" >&2; exit 1'
ExecStart=/opt/bin/mediamtx /etc/mediamtx.yml
Restart=always
RestartSec=5
LimitNOFILE=65536
WorkingDirectory=/etc

[Install]
WantedBy=multi-user.target
